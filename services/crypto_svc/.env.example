# Copy to .env and fill in. docker-compose reads .env automatically; go run
# uses these same variables directly.

# --- Service ---
PORT=8001
GRPC_PORT=50051

# --- HSM provider (software GP; real HSMs PS/AT plug in here) ---
CRYPTO_HSM=GP
# Software-HSM master key (hex). Empty = default sha256("lmk").
# In production set this to a strong, protected 256-bit value.
SOFTWARE_LMK=

# --- Auth (REST dual-auth; leave blank = endpoints open / PermitAll) ---
# ZITADEL_ISSUER must be the URL the service container uses (http://zitadel:8080
# inside compose); AUDIENCE is the Zitadel project id.
# REST accepts EITHER a bearer JWT (from this IdP) OR an API key (below).
ZITADEL_ISSUER=
AUDIENCE=
# Introspection client (opaque tokens): create an API app with JWT access tokens.
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# --- API keys (stateless, gRPC + REST) ---
# Prefix for issued/expected keys.
API_KEY_PREFIX=crypto_
# sha256 hex hashes of accepted API keys (comma-separated). Generate one with:
#   printf '%s' "<plaintext-key>" | shasum -a 256 | cut -d' ' -f1
API_KEYS=
# Roles granted to API-key callers (comma-separated); empty = admin.
API_KEY_ROLES=admin