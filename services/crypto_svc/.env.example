# Copy to .env and fill in. docker-compose reads .env automatically; go run
# uses these same variables directly.

# --- Service ---
PORT=8001
GRPC_PORT=50051
APP_ENV=development
ALLOW_INSECURE_AUTH=true
GRPC_REFLECTION=true

# --- HSM provider (software GP; real HSMs PS/AT plug in here) ---
CRYPTO_HSM=GP
# Software-HSM master key (hex). Empty uses the deterministic GP development
# key. GP cannot run when APP_ENV=production; real HSMs retain native custody.
SOFTWARE_LMK=

# --- API keys (headless service-to-service auth; REST + gRPC) ---
# Prefix for expected keys.
API_KEY_PREFIX=crypto_
# sha256 hex hashes of accepted API keys (comma-separated). Generate one with:
#   printf '%s' "<plaintext-key>" | shasum -a 256 | cut -d' ' -f1
# Blank API_KEYS is accepted only with the explicit local override above.
API_KEYS=
# Roles granted to API-key callers (comma-separated); empty = admin.
API_KEY_ROLES=admin

# Internal clear-key command. Keep disabled normally. Enabling requires API_KEYS
# and authenticated callers whose API_KEY_ROLES includes key_custodian.
ENABLE_INTERNAL_UNWRAP=false
